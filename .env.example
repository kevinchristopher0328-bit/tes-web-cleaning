# Asisten AI "Bantu" (widget chat) memanggil Google Gemini lewat /api/chat.
# Salin file ini ke .env.local dan isi API key dari https://aistudio.google.com/apikey
# (free tier, model gemini-2.5-flash)
GEMINI_API_KEY=...

# Pemesanan (/api/orders) menyimpan order ke Notion database "Beres Orders".
# Buat internal integration di https://www.notion.so/my-integrations, salin
# token-nya, lalu "Connect" integration itu ke database Beres Orders.
NOTION_API_KEY=secret_...
